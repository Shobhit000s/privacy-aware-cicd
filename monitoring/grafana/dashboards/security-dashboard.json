{
  "title": "Privacy-Aware CI/CD Compliance Dashboard",
  "uid": "privacy-cicd-compliance",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Current Security Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "targets": [{ "expr": "pipeline_security_score", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "ML Privacy Risk Score (last 24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [{ "expr": "pipeline_risk_score", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 70 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Pipeline Success Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "avg_over_time(pipeline_run_status[24h]) * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4,
      "title": "Secrets Detected (Gitleaks) — 7d",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum_over_time(gitleaks_findings_count[7d])", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Vulnerabilities Blocked (Trivy) — 7d",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "sum_over_time(trivy_critical_count[7d])", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Secrets Rotated — 7d",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "sum_over_time(secret_rotation_count[7d])", "refId": "A" }]
    },
    {
      "id": 7,
      "title": "OPA Policy Denials by Rule — 30d",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum by (rule) (opa_policy_denial_total)", "refId": "A" }]
    }
  ]
}
